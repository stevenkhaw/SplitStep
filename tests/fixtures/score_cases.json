{
  "defaultRules": {"players": ["Me", "Opp"], "sets": 3, "ad": true, "tiebreak": "at6",
                   "tiebreakTo": 7, "firstServer": null},
  "cases": [
    {"name": "empty", "winners": "",
     "expect": {"sets": [], "games": [0, 0], "points": ["0", "0"], "inTiebreak": false, "finished": null, "server": null}},
    {"name": "love game", "winners": "aaaa",
     "expect": {"sets": [], "games": [1, 0], "points": ["0", "0"], "inTiebreak": false, "finished": null, "server": null}},
    {"name": "40-15", "winners": "aaab",
     "expect": {"sets": [], "games": [0, 0], "points": ["40", "15"], "inTiebreak": false, "finished": null, "server": null}},
    {"name": "deuce", "winners": "aaabbb",
     "expect": {"sets": [], "games": [0, 0], "points": ["40", "40"], "inTiebreak": false, "finished": null, "server": null}},
    {"name": "ad in", "winners": "aaabbba",
     "expect": {"sets": [], "games": [0, 0], "points": ["Ad", "40"], "inTiebreak": false, "finished": null, "server": null}},
    {"name": "back to deuce", "winners": "aaabbbab",
     "expect": {"sets": [], "games": [0, 0], "points": ["40", "40"], "inTiebreak": false, "finished": null, "server": null}},
    {"name": "ad out", "winners": "aaabbbabb",
     "expect": {"sets": [], "games": [0, 0], "points": ["40", "Ad"], "inTiebreak": false, "finished": null, "server": null}},
    {"name": "game from ad out", "winners": "aaabbbabbb",
     "expect": {"sets": [], "games": [0, 1], "points": ["0", "0"], "inTiebreak": false, "finished": null, "server": null}},
    {"name": "no-ad deuce is sudden death", "rules": {"ad": false}, "winners": "aaabbbb",
     "expect": {"sets": [], "games": [0, 1], "points": ["0", "0"], "inTiebreak": false, "finished": null, "server": null}},
    {"name": "no-ad 40-40 still reads 40-40", "rules": {"ad": false}, "winners": "aaabbb",
     "expect": {"sets": [], "games": [0, 0], "points": ["40", "40"], "inTiebreak": false, "finished": null, "server": null}},
    {"name": "set 6-4", "winners": "aaaabbbbaaaabbbbaaaabbbbaaaabbbbaaaaaaaa",
     "expect": {"sets": [[6, 4]], "games": [0, 0], "points": ["0", "0"], "inTiebreak": false, "finished": null, "server": null}},
    {"name": "set 7-5", "winners": "aaaabbbbaaaabbbbaaaabbbbaaaabbbbaaaabbbbaaaaaaaa",
     "expect": {"sets": [[7, 5]], "games": [0, 0], "points": ["0", "0"], "inTiebreak": false, "finished": null, "server": null}},
    {"name": "6-6 enters a tiebreak", "winners": "aaaabbbbaaaabbbbaaaabbbbaaaabbbbaaaabbbbaaaabbbb",
     "expect": {"sets": [], "games": [6, 6], "points": ["0", "0"], "inTiebreak": true, "finished": null, "server": null}},
    {"name": "tiebreak 7-0 wins the set 7-6", "winners": "aaaabbbbaaaabbbbaaaabbbbaaaabbbbaaaabbbbaaaabbbbaaaaaaa",
     "expect": {"sets": [[7, 6]], "games": [0, 0], "points": ["0", "0"], "inTiebreak": false, "finished": null, "server": null}},
    {"name": "tiebreak 6-6 is not over", "winners": "aaaabbbbaaaabbbbaaaabbbbaaaabbbbaaaabbbbaaaabbbbaaaaaabbbbbb",
     "expect": {"sets": [], "games": [6, 6], "points": ["6", "6"], "inTiebreak": true, "finished": null, "server": null}},
    {"name": "tiebreak needs two clear", "winners": "aaaabbbbaaaabbbbaaaabbbbaaaabbbbaaaabbbbaaaabbbbaaaaaabbbbbbaa",
     "expect": {"sets": [[7, 6]], "games": [0, 0], "points": ["0", "0"], "inTiebreak": false, "finished": null, "server": null}},
    {"name": "advantage set plays on at 6-6", "rules": {"tiebreak": "none"},
     "winners": "aaaabbbbaaaabbbbaaaabbbbaaaabbbbaaaabbbbaaaabbbbaaaaaaaa",
     "expect": {"sets": [[8, 6]], "games": [0, 0], "points": ["0", "0"], "inTiebreak": false, "finished": null, "server": null}},
    {"name": "best of 3 ends at two sets", "winners": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
     "expect": {"sets": [[6, 0], [6, 0]], "games": [0, 0], "points": ["0", "0"], "inTiebreak": false, "finished": "a", "server": null}},
    {"name": "points after match point are ignored", "winners": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaabbb",
     "expect": {"sets": [[6, 0], [6, 0]], "games": [0, 0], "points": ["0", "0"], "inTiebreak": false, "finished": "a", "server": null}},
    {"name": "best of 1", "rules": {"sets": 1}, "winners": "aaaaaaaaaaaaaaaaaaaaaaaa",
     "expect": {"sets": [[6, 0]], "games": [0, 0], "points": ["0", "0"], "inTiebreak": false, "finished": "a", "server": null}},
    {"name": "tiebreak-only to 7", "rules": {"tiebreak": "only"}, "winners": "aaaaaaa",
     "expect": {"sets": [], "games": [0, 0], "points": ["7", "0"], "inTiebreak": true, "finished": "a", "server": null}},
    {"name": "tiebreak-only 6-6 is not over", "rules": {"tiebreak": "only"}, "winners": "aaaaaabbbbbb",
     "expect": {"sets": [], "games": [0, 0], "points": ["6", "6"], "inTiebreak": true, "finished": null, "server": null}},
    {"name": "tiebreak-only to 10", "rules": {"tiebreak": "only", "tiebreakTo": 10}, "winners": "aaaaaaaaab",
     "expect": {"sets": [], "games": [0, 0], "points": ["9", "1"], "inTiebreak": true, "finished": null, "server": null}},
    {"name": "tiebreak-only to 10 finishes", "rules": {"tiebreak": "only", "tiebreakTo": 10}, "winners": "aaaaaaaaaba",
     "expect": {"sets": [], "games": [0, 0], "points": ["10", "1"], "inTiebreak": true, "finished": "a", "server": null}},
    {"name": "no first server means no server", "rules": {"firstServer": null}, "winners": "aaa",
     "expect": {"sets": [], "games": [0, 0], "points": ["40", "0"], "inTiebreak": false, "finished": null,
                "server": null}},
    {"name": "the first server serves the first point", "rules": {"firstServer": "a"}, "winners": "",
     "expect": {"sets": [], "games": [0, 0], "points": ["0", "0"], "inTiebreak": false, "finished": null,
                "server": "a"}},
    {"name": "the server does not change inside a game", "rules": {"firstServer": "b"}, "winners": "aaa",
     "expect": {"sets": [], "games": [0, 0], "points": ["40", "0"], "inTiebreak": false, "finished": null,
                "server": "b"}},
    {"name": "serve passes at the end of a game", "rules": {"firstServer": "a"}, "winners": "aaaa",
     "expect": {"sets": [], "games": [1, 0], "points": ["0", "0"], "inTiebreak": false, "finished": null,
                "server": "b"}},
    {"name": "and comes back the game after", "rules": {"firstServer": "a"}, "winners": "aaaabbbb",
     "expect": {"sets": [], "games": [1, 1], "points": ["0", "0"], "inTiebreak": false, "finished": null,
                "server": "a"}},
    {"name": "three games in, serve is the receiver's", "rules": {"firstServer": "b"},
     "winners": "aaaabbbbaaaa",
     "expect": {"sets": [], "games": [2, 1], "points": ["0", "0"], "inTiebreak": false, "finished": null,
                "server": "a"}},
    {"name": "the tiebreak's first point is served by whoever would serve the next game",
     "rules": {"firstServer": "a"}, "winners": "aaaabbbbaaaabbbbaaaabbbbaaaabbbbaaaabbbbaaaabbbb",
     "expect": {"sets": [], "games": [6, 6], "points": ["0", "0"], "inTiebreak": true, "finished": null,
                "server": "a"}},
    {"name": "then serve changes after one point", "rules": {"firstServer": "a"}, "winners": "aaaabbbbaaaabbbbaaaabbbbaaaabbbbaaaabbbbaaaabbbba",
     "expect": {"sets": [], "games": [6, 6], "points": ["1", "0"], "inTiebreak": true, "finished": null,
                "server": "b"}},
    {"name": "and every two points after that", "rules": {"firstServer": "a"}, "winners": "aaaabbbbaaaabbbbaaaabbbbaaaabbbbaaaabbbbaaaabbbbab",
     "expect": {"sets": [], "games": [6, 6], "points": ["1", "1"], "inTiebreak": true, "finished": null,
                "server": "b"}},
    {"name": "three points into a tiebreak it is back", "rules": {"firstServer": "a"}, "winners": "aaaabbbbaaaabbbbaaaabbbbaaaabbbbaaaabbbbaaaabbbbaba",
     "expect": {"sets": [], "games": [6, 6], "points": ["2", "1"], "inTiebreak": true, "finished": null,
                "server": "a"}},
    {"name": "five points into a tiebreak", "rules": {"firstServer": "a"}, "winners": "aaaabbbbaaaabbbbaaaabbbbaaaabbbbaaaabbbbaaaabbbbababa",
     "expect": {"sets": [], "games": [6, 6], "points": ["3", "2"], "inTiebreak": true, "finished": null,
                "server": "b"}},
    {"name": "after a tiebreak the set's first server receives",
     "rules": {"firstServer": "a"}, "winners": "aaaabbbbaaaabbbbaaaabbbbaaaabbbbaaaabbbbaaaabbbbaaaaaaa",
     "expect": {"sets": [[7, 6]], "games": [0, 0], "points": ["0", "0"], "inTiebreak": false,
                "finished": null, "server": "b"}},
    {"name": "a tiebreak-only session opens on its first server",
     "rules": {"tiebreak": "only", "firstServer": "b"}, "winners": "",
     "expect": {"sets": [], "games": [0, 0], "points": ["0", "0"], "inTiebreak": true, "finished": null,
                "server": "b"}},
    {"name": "a tiebreak-only session rotates on the same two-point rule",
     "rules": {"tiebreak": "only", "firstServer": "b"}, "winners": "aaa",
     "expect": {"sets": [], "games": [0, 0], "points": ["3", "0"], "inTiebreak": true, "finished": null,
                "server": "b"}},
    {"name": "a finished match has nobody serving", "rules": {"firstServer": "a"},
     "winners": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
     "expect": {"sets": [[6, 0], [6, 0]], "games": [0, 0], "points": ["0", "0"], "inTiebreak": false,
                "finished": "a", "server": null}},
    {"name": "an anchor is the state the replay starts from",
     "anchor": {"sets": [[6, 4]], "games": [3, 2], "points": [2, 1]}, "winners": "",
     "expect": {"sets": [[6, 4]], "games": [3, 2], "points": ["30", "15"], "inTiebreak": false,
                "finished": null, "server": null}},
    {"name": "points after an anchor build on it",
     "anchor": {"sets": [[6, 4]], "games": [3, 2], "points": [2, 1]}, "winners": "aa",
     "expect": {"sets": [[6, 4]], "games": [4, 2], "points": ["0", "0"], "inTiebreak": false,
                "finished": null, "server": null}},
    {"name": "an anchor at 6-6 is inside the tiebreak",
     "anchor": {"sets": [], "games": [6, 6], "points": [3, 2]}, "winners": "",
     "expect": {"sets": [], "games": [6, 6], "points": ["3", "2"], "inTiebreak": true,
                "finished": null, "server": null}},
    {"name": "an anchor at 6-6 with no tiebreak plays on", "rules": {"tiebreak": "none"},
     "anchor": {"sets": [], "games": [6, 6], "points": [0, 0]}, "winners": "aaaa",
     "expect": {"sets": [], "games": [7, 6], "points": ["0", "0"], "inTiebreak": false,
                "finished": null, "server": null}},
    {"name": "an anchor at deuce reads the advantage",
     "anchor": {"sets": [], "games": [0, 0], "points": [3, 3]}, "winners": "a",
     "expect": {"sets": [], "games": [0, 0], "points": ["Ad", "40"], "inTiebreak": false,
                "finished": null, "server": null}},
    {"name": "an anchor's games count as service units", "rules": {"firstServer": "a"},
     "anchor": {"sets": [], "games": [1, 0], "points": [0, 0]}, "winners": "",
     "expect": {"sets": [], "games": [1, 0], "points": ["0", "0"], "inTiebreak": false,
                "finished": null, "server": "b"}},
    {"name": "and so do the games of an anchored set", "rules": {"firstServer": "a"},
     "anchor": {"sets": [[7, 6]], "games": [0, 0], "points": [0, 0]}, "winners": "",
     "expect": {"sets": [[7, 6]], "games": [0, 0], "points": ["0", "0"], "inTiebreak": false,
                "finished": null, "server": "b"}},
    {"name": "an anchor with the match already won is finished", "rules": {"firstServer": "a"},
     "anchor": {"sets": [[6, 0], [6, 0]], "games": [0, 0], "points": [0, 0]}, "winners": "b",
     "expect": {"sets": [[6, 0], [6, 0]], "games": [0, 0], "points": ["0", "0"], "inTiebreak": false,
                "finished": "a", "server": null}},
    {"name": "a tiebreak-only anchor is a tiebreak count", "rules": {"tiebreak": "only"},
     "anchor": {"sets": [], "games": [0, 0], "points": [5, 3]}, "winners": "aa",
     "expect": {"sets": [], "games": [0, 0], "points": ["7", "3"], "inTiebreak": true,
                "finished": "a", "server": null}}
  ]
}
