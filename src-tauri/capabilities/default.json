{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Commands the shell exposes, to the launcher and to the page the sidecar serves.",
  "windows": [
    "main"
  ],
  "local": true,
  "remote": {
    "urls": [
      "http://127.0.0.1:*",
      "http://localhost:*"
    ]
  },
  "permissions": [
    "core:default",
    "dialog:default",
    "notification:default",
    "allow-home",
    "allow-known",
    "allow-configured",
    "allow-pick-folder",
    "allow-free-space",
    "allow-has-library",
    "allow-open-library",
    "allow-back-to-chooser"
  ]
}
